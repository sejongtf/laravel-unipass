{
    "name": "sejongtf/laravel-unipass",
    "type": "library",
    "description": "관세청 UNI-PASS 공개 API 연계 (화물통관진행정보 등)",
    "license": "MIT",
    "authors": [
        {
            "name": "Minhyung Park",
            "email": "minhyung.park@sejongtf.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-simplexml": "*",
        "illuminate/support": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/console": "^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Sejongtf\\LaravelUnipass\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Sejongtf\\LaravelUnipass\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Sejongtf\\LaravelUnipass\\UnipassServiceProvider"
            ]
        }
    }
}
